<%- include('partials/header') %>

<div class="row g-4 mb-4">
  <!-- Stat Card: Students -->
  <div class="col-md-4">
    <div class="card p-3 border-start border-4 border-primary">
      <div class="d-flex align-items-center">
        <div class="bg-primary bg-opacity-10 p-3 rounded-circle me-3 text-primary fs-3">
          <i class="fa-solid fa-user-graduate"></i>
        </div>
        <div>
          <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size: 0.8rem;">Tổng số sinh viên</h6>
          <h3 class="mb-0 fw-bold"><%= totalStudents %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Stat Card: Classes -->
  <div class="col-md-4">
    <div class="card p-3 border-start border-4 border-success">
      <div class="d-flex align-items-center">
        <div class="bg-success bg-opacity-10 p-3 rounded-circle me-3 text-success fs-3">
          <i class="fa-solid fa-chalkboard-user"></i>
        </div>
        <div>
          <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size: 0.8rem;">Số lượng lớp học</h6>
          <h3 class="mb-0 fw-bold"><%= totalClasses %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Stat Card: Grades -->
  <div class="col-md-4">
    <div class="card p-3 border-start border-4 border-warning">
      <div class="d-flex align-items-center">
        <div class="bg-warning bg-opacity-10 p-3 rounded-circle me-3 text-warning fs-3">
          <i class="fa-solid fa-award"></i>
        </div>
        <div>
          <h6 class="text-muted mb-1 text-uppercase fw-semibold" style="font-size: 0.8rem;">Bản ghi điểm môn</h6>
          <h3 class="mb-0 fw-bold"><%= totalGrades %></h3>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Quick Actions & Recent Students Table -->
<div class="row g-4">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i>Sinh viên vừa thêm gần đây</h5>
        <a href="/students" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead>
            <tr>
              <th>Mã SV</th>
              <th>Họ và Tên</th>
              <th>Giới tính</th>
              <th>Lớp</th>
              <th>Email</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentStudents.length === 0) { %>
              <tr><td colspan="5" class="text-center py-4 text-muted">Chưa có dữ liệu sinh viên nào.</td></tr>
            <% } %>
            <% recentStudents.forEach(st => { %>
              <tr>
                <td class="fw-bold text-primary"><%= st.student_code %></td>
                <td><%= st.full_name %></td>
                <td><span class="badge <%= st.gender === 'Nam' ? 'bg-info text-dark' : 'bg-warning text-dark' %>"><%= st.gender %></span></td>
                <td><span class="badge badge-class"><%= st.class_name || 'Chưa phân lớp' %></span></td>
                <td><small class="text-muted"><%= st.email %></small></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold text-dark"><i class="fa-solid fa-server me-2 text-primary"></i>Trạng thái Hệ thống</h5>
      </div>
      <div class="card-body">
        <ul class="list-group list-group-flush">
          <li class="list-group-item d-flex justify-content-between align-items-center px-0">
            <span><i class="fa-solid fa-circle-check text-success me-2"></i>Ứng dụng Web</span>
            <span class="badge bg-success">Online (Port 3000)</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center px-0">
            <span><i class="fa-solid fa-database text-primary me-2"></i>MySQL Database</span>
            <span class="badge bg-primary">Connected (Port 3306)</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center px-0">
            <span><i class="fa-solid fa-shield-halved text-info me-2"></i>phpMyAdmin</span>
            <span class="badge bg-info text-dark">Active (Port 8080)</span>
          </li>
          <li class="list-group-item d-flex justify-content-between align-items-center px-0">
            <span><i class="fa-solid fa-user-shield text-danger me-2"></i>Quyền thực thi</span>
            <span class="badge bg-dark">Non-Root User (UID 1001)</span>
          </li>
        </ul>
        <div class="mt-3 text-center">
          <a href="/students" class="btn btn-primary w-100 mb-2"><i class="fa-solid fa-user-plus me-1"></i> Quản lý sinh viên ngay</a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
